# GEMINI_API_KEY: Required for Google AI Studio Gemini API calls & Gemini 3.8 Expressive TTS.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI / ChatGPT API (Optional server-side key for GPT chat & gpt-4o-mini-tts realistic voice)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"

# Cloudflare Workers AI (Optional for local REST usage; automatic via [ai] binding when deployed to Cloudflare)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
